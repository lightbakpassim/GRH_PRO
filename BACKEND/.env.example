# Copier vers application-local.properties (non versionné) ou exporter ces variables.
DB_URL=jdbc:mariadb://localhost:3306/gestionRH?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=votre_mot_de_passe
JWT_SECRET=changez_moi_en_base64_32octets_minimum
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
SEED_TEST_USERS=true

# Comptes créés (une seule fois) si SEED_TEST_USERS=true — MDP non réécrit ensuite :
#   SuperAdmin → plateforme@grh.tg / plateforme123  (console /plateforme)
#   Admin      → admin@grh.tg      / admin123
#   DG         → dg@grh.tg         / dgChangeMe1  (à changer après 1re connexion)
# En production : SEED_TEST_USERS=false (défaut application.properties)

# SMTP — email réel des identifiants à la création d'employé
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre_compte@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_application
MAIL_FROM=votre_compte@gmail.com
